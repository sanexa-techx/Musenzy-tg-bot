modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram Music Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram Session Login"

[[workflows.workflow]]
name = "Telegram Music Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python services/telegram-music-bot/main.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Telegram Session Login"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -u services/telegram-music-bot/generate_session_interactive.py +918584900905"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
